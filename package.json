{
  "name": "metricyak",
  "version": "0.0.0",
  "description": "Build self-improving products.",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "keywords": [],
  "author": "MetricYak",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "pino-pretty": "^13.2.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "dependencies": {
    "pino": "^10.4.0"
  }
}
